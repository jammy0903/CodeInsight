# ============================================
# CodeInsight — Environment Variables
# ============================================
# 모든 값에 기본값이 있어 .env 없이도 로컬에서 실행됩니다.
# 바꾸고 싶은 값만 .env에 적으세요 (.env는 커밋하지 않습니다).
#
# 백엔드 상세 설정: packages/backend/.env.example

# === Frontend ===
VITE_API_URL=http://localhost:3002

# === Backend ===
PORT=3002
DATABASE_URL=postgresql://codeinsight:codeinsight123@localhost:5432/codeinsight
CORS_ORIGINS=http://localhost:5174
