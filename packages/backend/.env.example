# ========================================
# CodeInsight Backend Environment Variables
# ========================================
# Copy this file to .env and fill in your values.
# 모든 항목에 기본값이 있습니다 (src/config/env.ts).

# === Database (PostgreSQL) ===
# 레슨 콘텐츠 조회에만 사용합니다. 시뮬레이터는 DB 없이 동작합니다.
DATABASE_URL="postgresql://codeinsight:codeinsight123@localhost:5432/codeinsight"

# === Server ===
PORT=3002
NODE_ENV=development

# === CORS (comma-separated origins) ===
CORS_ORIGINS=http://localhost:5174

# === C Execution ===
C_RUN_DEFAULT_TIMEOUT=10        # seconds
C_RUN_MAX_TIMEOUT=30            # seconds
C_EXECUTOR_BUFFER_SIZE=10485760 # bytes

# === Code Limits ===
CODE_MAX_LENGTH=50000
JSON_BODY_LIMIT=1mb

# === JavaScript Simulator Engine ===
# inspector (기본, V8 Inspector) | legacy (AST)
JS_SIM_ENGINE=inspector
