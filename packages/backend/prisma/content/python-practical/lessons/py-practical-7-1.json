    "code": "import pandas as pd\nimport seaborn as sns\nimport matplotlib.pyplot as plt\nfrom openpyxl import Workbook\nfrom pptx import Presentation\nfrom pptx.util import Inches\nimport os\nfrom datetime import datetime\n\n# 1. 데이터 준비\ndf = pd.read_csv('monthly_sales.csv')\ndf_clean = df.dropna()\n\n# 2. 분석\npivot = df_clean.pivot_table(values='매출', index='부서', columns='월', aggfunc='sum')\ntotal = df_clean['매출'].sum()\navg = df_clean['매출'].mean()\n\n# 3. 시각화\nsns.set_theme(style='whitegrid')\nsns.barplot(data=df_clean, x='부서', y='매출')\nplt.title(f'Monthly Sales Report - {datetime.now():%Y-%m}')\nplt.savefig('chart.png', dpi=300)\nplt.close()\n\n# 4. Excel 저장\nwb = Workbook()\nws = wb.active\nws['A1'] = '월간 매출 보고서'\nfor r_idx, row in enumerate(pivot.itertuples(), start=3):\n    for c_idx, value in enumerate(row, start=1):\n        ws.cell(row=r_idx, column=c_idx, value=value)\nwb.save('report.xlsx')\n\n# 5. PPT 생성\nprs = Presentation()\nslide = prs.slides.add_slide(prs.slide_layouts[5])\nslide.shapes.title.text = '월간 매출 보고서'\nprs.save('report.pptx')\n\nprint('보고서 생성 완료!')",
