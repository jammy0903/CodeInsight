  "quiz": {
    "question": "How to compare String[] arrays?",
    "options": [
      "arr1 == arr2",
      "arr1.equals(arr2)",
      "Arrays.equals(arr1, arr2)",
      "arr1.toString().equals(arr2.toString())"
    ],
    "correctIndex": 2,
    "explanation": "Arrays.equals() goes through each element and calls .equals().\nThere is no problem with String because equals() is well implemented."
  },
  "misconceptions": [
    {
      "wrong": "You can also compare arrays with .equals().",
      "correct": "Arrays must be compared with `Arrays.equals()`.",
      "why": "`.equals()` on an array itself is identical to address comparison (==).\nThis is one of the disappointing aspects of Java's design."
    }
  ],
  "keyTakeaway": "1-dimensional: Arrays.equals(), multi-dimensional: Arrays.deepEquals()"
