  "quiz": {
    "question": "객체를 메서드에 전달했을 때 가능한 것은?",
    "options": [
      "객체 자체를 다른 객체로 교체",
      "객체의 필드 값 변경",
      "둘 다 가능",
      "둘 다 불가능"
    ],
    "correctIndex": 1,
    "explanation": "필드 변경은 같은 객체를 참조하므로 가능합니다. 하지만 참조를 재할당해도 원본 변수는 영향 없습니다."
  },
  "misconceptions": [
    {
      "wrong": "Java는 객체를 Pass by Reference로 전달한다",
      "correct": "Java는 항상 Pass by Value입니다. 객체의 경우 '참조값'이 복사됩니다.",
      "why": "참조 자체가 전달되면 재할당이 원본에 영향을 줘야 하지만, 그렇지 않습니다."
    }
  ],
  "keyTakeaway": "참조값 복사 = 내부 수정 OK, 재할당은 지역 변수만"
}
