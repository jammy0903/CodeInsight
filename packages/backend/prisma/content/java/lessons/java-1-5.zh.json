  "quiz": {
    "question": "什么是 equals/hashCode 合约？",
    "options": [
      "如果 equals() 为 true，则 hashCode() 也必须相同。",
      "如果 hashCode() 相等，则 equals() 也必须为 true。",
      "两者应始终返回相同的值",
      "您只需要覆盖两者之一。"
    ],
    "correctIndex": 0,
    "explanation": "请记住：如果 equals() 相等，那么 hashCode() 也必须相等！ （不一定要建站）"
  },
  "misconceptions": [
    {
      "wrong": "只需重写 equals()",
      "correct": "您还必须重写“hashCode()”。",
      "why": "HashMap、HashSet等数据结构首先用`hashCode`进行分类（旧名），然后用`equals`进行二次确认（地址编号）。\n如果区名不同，你将永远找不到你的家。"
    }
  ],
  "keyTakeaway": "当重写 equals() 时，还需要 hashCode()。利用 IDE 的自动生成功能。"
