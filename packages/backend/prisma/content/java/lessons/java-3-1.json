  "quiz": {
    "question": "Java의 기본 타입 호출 방식은?",
    "options": [
      "Call by Reference",
      "Call by Value",
      "Call by Name",
      "Call by Need"
    ],
    "correctIndex": 1,
    "explanation": "Java는 오직 **Call by Value(값에 의한 호출)**만 존재합니다. 변수의 값을 복사해서 전달합니다."
  },
