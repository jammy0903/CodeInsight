  "quiz": {
    "question": "다음 중 NullPointerException이 발생하지 않는 것은?",
    "options": [
      "null.toString()",
      "((String)null).length()",
      "\"test\".equals(null)",
      "null.equals(\"test\")"
    ],
    "correctIndex": 2,
    "explanation": "\"test\".equals(null)은 \"test\" 객체에서 호출하므로 안전합니다. null과 비교하면 false를 반환합니다."
  },
  "misconceptions": [
    {
