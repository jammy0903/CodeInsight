  "quiz": {
    "question": "String s = \"abc\"; s.toUpperCase(); What is the value of s after?",
    "options": [
      "\"ABC\"",
      "\"abc\"",
      "null",
      "compile error"
    ],
    "correctIndex": 1,
    "explanation": "String is immutable.\n\n`s.toUpperCase()` returns a new String `\"ABC\"`, but\nSince we didn't reassign to s, s is still \"abc\".\n\nTo change: `s = s.toUpperCase();`"
  }
