  "quiz": {
    "question": "다음 중 ==가 true인 경우는?",
    "options": [
      "Integer a = 200; Integer b = 200; a == b",
      "Integer a = 100; Integer b = 100; a == b",
      "Integer a = new Integer(100); Integer b = 100; a == b",
      "Integer a = -200; Integer b = -200; a == b"
    ],
    "correctIndex": 1,
    "explanation": "100은 캐시 범위(-128~127) 내이고 오토박싱이므로 같은 캐시 객체를 참조합니다. 200, -200은 범위 밖, new는 항상 새 객체입니다."
  },
  "misconceptions": [
    {
      "wrong": "Integer는 항상 ==로 비교해도 된다",
