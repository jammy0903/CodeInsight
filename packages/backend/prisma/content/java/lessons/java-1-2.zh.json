  "quiz": {
    "question": "字符串池的目的是什么？",
    "options": [
      "提高安全性",
      "节省内存",
      "加快",
      "垃圾收集优化"
    ],
    "correctIndex": 1,
    "explanation": "即使多次使用相同的字符串文字，也可以仅创建一个对象来节省内存。"
  },
  "misconceptions": [
    {
      "wrong": "字符串总是可以用 == 进行比较。",
      "correct": "字符串比较必须始终使用“.equals()”。",
      "why": "对于文字，由于池的原因，“==”可能会运气好，但从用户输入或文件读取的字符串将被视为“new”对象，并且“==”将失败。"
    },
    {
      "wrong": "即使内存已满，字符串池也不会被清空。",
      "correct": "字符串池也受到垃圾收集（GC）的影响。",
      "why": "Java 7之前，PermGen区存在内存不足的问题，但从Java 7开始，它被移至通用Heap，如果没有引用则自动清理。"
    }
  ],
  "keyTakeaway": "文字在 Pool 中被重用，并且 new 总是创建一个新对象。比较是通过 .equals() 完成的！"
