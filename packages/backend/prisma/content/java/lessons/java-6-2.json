  "quiz": {
    "question": "오버라이딩 규칙으로 틀린 것은?",
    "options": [
      "메서드 이름, 파라미터가 같아야 한다",
      "리턴 타입은 같거나 하위 타입이어야 한다",
      "접근 제어자를 더 좁게 변경할 수 있다",
      "private 메서드는 오버라이드 불가"
    ],
    "correctIndex": 2,
    "explanation": "오버라이딩 시 접근 제어자는 같거나 더 넓어야 합니다. 좁히면 컴파일 에러!"
  },
  "misconceptions": [
    {
      "wrong": "오버라이딩과 오버로딩은 같다",
