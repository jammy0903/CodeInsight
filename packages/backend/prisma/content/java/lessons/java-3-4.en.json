  "quiz": {
    "question": "What is the correct way to swap two variables in Java?",
    "options": [
      "Create a swap(a, b) function.",
      "Use pointers like in C.",
      "Use a wrapper class or array to hold the values.",
      "It's impossible."
    ],
    "correctIndex": 2,
    "explanation": "You can't swap the variables themselves, but you can put values inside an array (`int[]`) or object (`MyObj`) and create a function that swaps the 'contents'."
  },
  "misconceptions": [
    {
      "wrong": "Since Integer is an object, its contents should be modifiable, right?",
      "correct": "The `Integer` class is **immutable**.",
      "why": "Java designers made `Integer`, `String`, etc. so that their values can never be changed.\nThere's no way to set internal values either."
    }
  ],
  "keyTakeaway": "A variable swap function is impossible in Java. (The limitation of Call by Value)"
}
