  "quiz": {
    "question": "Java泛型中哪些类型不能输入T？",
    "options": [
      "细绳",
      "目的",
      "int（原始类型）",
      "列表<字符串>"
    ],
    "correctIndex": 2,
    "explanation": "泛型类型参数只能包含引用类型。\n您应该使用“Integer”包装类而不是“int”。"
  },
