  "quiz": {
    "question": "以下代码的输出是什么？\n\nlet arr1 = [1, 2, 3];\nlet arr2 = arr1;\narr2.push(4);\nconsole.log(arr1.length);",
    "options": [
      "3",
      "4",
      "undefined",
      "Error"
    ],
    "correctIndex": 1,
    "explanation": "数组也是引用值。\narr2 = arr1 使它们指向同一个数组。\narr2.push(4) 修改了原数组。"
  },
  "misconceptions": [
    {
      "wrong": "将对象赋值给变量会复制对象",
      "correct": "只有引用（地址）被复制了。\n对象只有一个。",
      "why": "对象存储在堆（Heap）中，变量只持有它们的地址。"
    }
  ],
  "keyTakeaway": "原始值 = 按值复制，引用值 = 按地址复制（共享同一个对象）"
