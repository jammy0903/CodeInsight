              "name": "a",
              "value": 10,
              "type": "primitive"
            },
            {
              "name": "b",
              "value": 10,
              "type": "primitive",
              "copied": true
            }
          ],
          "heap": []
        },
        "code": "let b = a;"
      },
      {
        "title": "b = 20（独立修改）",
        "explanation": "将 b 改为 20 不会影响 a。\n它们占用不同的内存空间。",
