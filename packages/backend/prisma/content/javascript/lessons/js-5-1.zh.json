  "title": "原始值与引用值",
  "concept": "原始值按值复制，而引用值（对象）按内存地址复制",
  "content": {
    "code": "// 원시값 (Primitive)\nlet a = 10;\nlet b = a;\nb = 20;\nconsole.log(a, b);\n\n// 참조값 (Reference)\nlet obj1 = { value: 10 };\nlet obj2 = obj1;\nobj2.value = 20;\nconsole.log(obj1.value, obj2.value);",
    "steps": [
      {
        "title": "原始值 a = 10",
        "explanation": "数字 10 被存储在内存中，a 持有该值。",
        "keyInsight": "原始类型：number、string、boolean、null、undefined、symbol、bigint",
        "visualizationType": "memory",
        "memoryState": {
          "stack": [
            {
              "name": "a",
