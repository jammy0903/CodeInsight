  "quiz": {
    "question": "What is the output of the following code?\n\nfunction apply(x, fn) { return fn(x); }\nfunction square(n) { return n * n; }\nconsole.log(apply(5, square));",
    "options": [
      "5",
      "10",
      "25",
      "undefined"
    ],
    "correctIndex": 2,
    "explanation": "In apply(5, square), fn is the square function.\nfn(x) = square(5) = 5 * 5 = 25 is returned."
  },
  "misconceptions": [
    {
      "wrong": "Callbacks are always executed asynchronously",
      "correct": "Not at all.\nCallbacks can be executed synchronously.",
      "why": "Array.map(), Array.filter() etc. use synchronous callbacks.\nOnly setTimeout, fetch, etc. use asynchronous callbacks."
    },
    {
      "wrong": "Callback functions require special syntax",
      "correct": "A callback is just a regular function.\nIt's simply a function passed as an argument to another function.",
      "why": "In JavaScript, functions are first-class objects, so they can be passed and stored just like values."
    }
  ],
  "keyTakeaway": "Callback = a function passed as an argument. It's a core pattern for separating logic and improving reusability."
}
