  "quiz": {
    "question": "What is the advantage of structuredClone()?",
    "options": [
      "It's the fastest",
      "It can handle circular references, Map, Set, Date, etc.",
      "It only supports shallow copying",
      "It works in Internet Explorer"
    ],
    "correctIndex": 1,
    "explanation": "structuredClone() can handle circular references, Map, Set, Date, and more.\nThe JSON method cannot handle these types."
  },
  "misconceptions": [
    {
      "wrong": "The spread operator makes a complete copy",
      "correct": "spread is a **Shallow Copy**.\nIt only copies the top level (depth 1), and nested objects are copied by reference.",
      "why": "For a true deep clone, you need `structuredClone()` or a recursive copy."
    }
  ],
  "keyTakeaway": "Shallow copy: spread, Object.assign / Deep copy: JSON, structuredClone"
}
