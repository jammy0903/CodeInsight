  "quiz": {
    "question": "await 做了什么？",
    "options": [
      "完全阻塞主线程",
      "暂停 async 函数并等待 Promise 完成",
      "立即终止函数",
      "没有任何效果"
    ],
    "correctIndex": 1,
    "explanation": "await 暂停 async 函数的执行，等待 Promise 解决。\n主线程不会被阻塞，可以继续处理其他任务。"
  },
  "misconceptions": [
    {
      "wrong": "await 会阻塞主线程",
      "correct": "await 只会暂停特定的 async 函数。\n主线程可以继续处理其他任务。",
      "why": "async/await 基于 Promise，所以事件循环会继续运行并处理其他事件。"
    }
  ],
  "keyTakeaway": "async/await = 用同步风格编写 Promise 的语法。await 暂停函数但不阻塞主线程。"
}