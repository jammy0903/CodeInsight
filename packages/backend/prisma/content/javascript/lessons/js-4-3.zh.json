  "content": {
    "code": "function delay(ms) {\n  return new Promise(resolve => setTimeout(resolve, ms));\n}\n\nasync function fetchUser() {\n  console.log('Fetching...');\n  await delay(1000);\n  console.log('User loaded');\n  return { name: 'Alice' };\n}\n\nasync function main() {\n  console.log('Start');\n  const user = await fetchUser();\n  console.log('Got:', user.name);\n  console.log('End');\n}\n\nmain();",
