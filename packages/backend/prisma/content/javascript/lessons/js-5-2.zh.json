  "quiz": {
    "question": "structuredClone() 的优势是什么？",
    "options": [
      "速度最快",
      "能处理循环引用、Map、Set、Date 等",
      "只支持浅拷贝",
      "兼容 Internet Explorer"
    ],
    "correctIndex": 1,
    "explanation": "structuredClone() 能处理循环引用、Map、Set、Date 等类型。\nJSON 方法无法处理这些类型。"
  },
  "misconceptions": [
    {
      "wrong": "展开运算符可以完整复制对象",
      "correct": "spread 是**浅拷贝**。\n它只复制顶层（深度 1），嵌套对象通过引用复制。",
      "why": "要实现真正的深克隆，需要使用 `structuredClone()` 或递归复制。"
    }
  ],
  "keyTakeaway": "浅拷贝：spread、Object.assign / 深拷贝：JSON、structuredClone"
}