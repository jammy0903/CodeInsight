  "quiz": {
    "question": "What is the output of the following code?\n\nfunction test() {\n  if (true) {\n    var a = 1;\n    let b = 2;\n  }\n  console.log(a);\n  console.log(b);\n}",
    "options": [
      "1, 2",
      "1, ReferenceError",
      "ReferenceError, 2",
      "ReferenceError, ReferenceError"
    ],
    "correctIndex": 1,
    "explanation": "var a has function scope, so it can be accessed outside the block (prints 1).\nlet b has block scope, so accessing it outside the block throws a ReferenceError."
  },
  "misconceptions": [
    {
      "wrong": "var declared inside a block is only valid inside that block",
      "correct": "var ignores blocks and registers itself in the nearest **function environment**.",
      "why": "Before executing code (during the creation phase), the JS engine finds all var declarations and registers them at the top of the function scope (hoisting)."
    }
  ],
  "keyTakeaway": "var = climbs up to the function, let/const = stays in the current block"
}
