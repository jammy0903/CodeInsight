  "quiz": {
    "question": "以下代码的输出是什么？\n\nlet x = 1;\nif (true) {\n  var x = 2;\n}\nconsole.log(x);",
    "options": [
      "1",
      "2",
      "发生错误",
      "undefined"
    ],
    "correctIndex": 2,
    "explanation": "在已经声明了 let x 的同一作用域中再声明 var x 会导致 SyntaxError。\n因为 var 忽略块，它试图在全局作用域中重新声明 x，这与 let 声明冲突。"
  },
  "misconceptions": [
    {
      "wrong": "var 也只在块内有效",
      "correct": "var 只遵循**函数作用域**。\n它忽略 if/for 块，可能意外地表现为全局变量。",
      "why": "这是 JavaScript 早期设计的遗留问题。\n因为它是无意中覆盖全局变量的主要元凶，现代 JS 避免使用它。"
    },
    {
      "wrong": "let 和 const 是一样的",
      "correct": "两者都是块级作用域的，但 const 不能被重新赋值。",
      "why": "const 是用于常量的关键字。\n但是，用 const 声明的对象的属性仍然可以被修改。"
    }
  ],
  "keyTakeaway": "var = 函数作用域（忽略块），let/const = 块级作用域"
}