  "quiz": {
    "question": "What problem occurs when a heavy synchronous task runs?",
    "options": [
      "A memory leak occurs",
      "The UI becomes unresponsive (freezing)",
      "Network requests are cancelled",
      "Variables are reset"
    ],
    "correctIndex": 1,
    "explanation": "JavaScript is single-threaded — when a heavy synchronous task holds the main thread, UI events (clicks, scrolls) can't be processed and the screen appears frozen."
  },
  "misconceptions": [
    {
      "wrong": "JavaScript is multi-threaded and processes multiple tasks simultaneously",
      "correct": "JavaScript has one main thread.\nYou need Web Workers to run code on a separate thread.",
      "why": "Browsers have separate threads for rendering, networking, etc., but JS code only runs on the main thread."
    },
    {
      "wrong": "A fast-running for loop won't affect the UI",
      "correct": "With a large number of iterations, the UI can freeze for several seconds.",
      "why": "Loops with more than a million iterations cause noticeable lag.\nSuch work should be split into chunks or moved to a Worker."
    }
  ],
  "keyTakeaway": "Single thread = one task at a time. Heavy synchronous work blocks the UI — use chunking or Web Workers."
}
