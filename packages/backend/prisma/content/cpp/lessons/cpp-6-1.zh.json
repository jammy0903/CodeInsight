  "quiz": {
    "question": "以下哪一个是右值？",
    "options": [
      "变量 x",
      "数组元素 arr[0]",
      "表达式 x + 1",
      "参考参考"
    ],
    "correctIndex": 2,
    "explanation": "x + 1 是操作产生的临时值，并且是右值，因为它没有名称且无法获取其地址。"
  },
  "misconceptions": [
    {
      "wrong": "右值引用就像常规引用一样",
      "correct": "右值引用 (&&) 仅绑定临时值，从而启用移动语义。",
      "why": "普通引用 (&) 仅绑定到命名对象（左值）。"
    }
  ],
  "keyTakeaway": "左值是“可寻址的”，右值是“临时的”。右值引用 (&&) 是移动语义的核心。"
