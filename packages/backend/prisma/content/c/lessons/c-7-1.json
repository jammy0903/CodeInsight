  "quiz": {
    "question": "int val = 5; int *p = &val; int **pp = &p; 일 때, val의 값을 읽는 방법이 아닌 것은?",
    "options": [
      "val",
      "*p",
      "**pp",
      "&p"
    ],
    "correctIndex": 3,
    "explanation": "&p는 포인터 p의 주소(pp의 값)이므로 5가 아닙니다. val == *p == **pp 입니다."
  },
