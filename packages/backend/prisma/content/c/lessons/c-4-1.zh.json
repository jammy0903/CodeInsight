  "quiz": {
    "question": "如果函数递归调用 10,000 次导致栈空间耗尽，会发生什么错误？",
    "options": [
      "Heap Overflow",
      "Stack Overflow",
      "Memory Leak",
      "Segmentation Fault"
    ],
    "correctIndex": 1,
    "explanation": "超出栈空间（通常 1MB-8MB）时无法再 push 新帧，导致 Stack Overflow 错误。"
  },
  "misconceptions": [
    {
      "wrong": "funcA 的变量 a 可以在 funcB 中使用",
      "correct": "看不到（作用域限制）。",
      "why": "`funcB` 只能看到自己帧中的变量。\n`funcA` 的帧在不同层，无法访问。"
    }
  ],
  "keyTakeaway": "函数调用 = 栈帧 Push，返回 = Pop。每个函数只使用自己房间（帧）中的数据。"
}