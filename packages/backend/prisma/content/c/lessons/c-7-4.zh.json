  "quiz": {
    "question": "void 指针 ptr 上不能进行哪些操作？",
    "options": [
      "ptr =#",
      "ptr = malloc(10);",
      "*ptr = 10；",
      "(int *)ptr"
    ],
    "correctIndex": 2,
    "explanation": "由于 void 指针不知道目标大小（字节大小），因此无法在不进行强制转换的情况下直接取消引用（*ptr）。"
  },
  "misconceptions": [
    {
      "wrong": "任何值都可以放入 void * 中（例如 int、float 值本身）。",
      "correct": "只能输入“地址”。\n如果您输入值本身，则该值将被解释为地址。",
      "why": "指针变量不是值的容器，而是指向位置的箭头。"
    }
  ],
  "keyTakeaway": "在隐藏数据类型和编写通用代码（例如 memcpy、qsort）时，空指针是必不可少的。"
}
