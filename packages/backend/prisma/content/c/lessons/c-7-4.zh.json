  "quiz": {
    "question": "对 void 指针 ptr 不可能进行哪个操作？",
    "options": [
      "ptr = &num;",
      "ptr = malloc(10);",
      "*ptr = 10;",
      "(int *)ptr"
    ],
    "correctIndex": 2,
    "explanation": "void 指针不知道目标的字节大小，因此不能在没有类型转换的情况下直接解引用（*ptr）。"
  },
  "misconceptions": [
    {
      "wrong": "可以往 void* 中放任何值（如 int、float 值本身）。",
      "correct": "它只能保存地址。\n直接放入值会被解释为地址。",
      "why": "指针变量不是存放值的容器——而是指向位置的箭头。"
    }
  ],
  "keyTakeaway": "Void 指针通过隐藏数据类型，在编写类型通用代码（如 memcpy、qsort）时必不可少。"
}