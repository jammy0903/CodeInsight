  "quiz": {
    "question": "结构体A*ptr；访问成员 x 的正确方法是什么",
    "options": [
      "指针x",
      "指针->x",
      "*ptr.x",
      "&ptr.x"
    ],
    "correctIndex": 1,
    "explanation": "由于它是一个指针，因此必须使用箭头（`->`）。\n仅当 ptr 是结构变量时才使用“ptr.x”。\n由于运算符优先级，`*ptr.x` 变成了 `*(ptr.x)`，这是不正确的语法。"
  },
  "misconceptions": [
    {
      "wrong": "`->` 是一个 C++ 特性",
      "correct": "这是C语言的一个基本特征。",
      "why": "这是由于结构指针访问过于频繁而创建的快捷方式。"
    }
  ],
  "keyTakeaway": "对于结构指针，请使用“->”而不是“.”。"
