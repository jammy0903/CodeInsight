  "quiz": {
    "question": "整数值=5； int *p = &val; int **pp = &p;什么时候，什么不是读取 val 值的方法？",
    "options": [
      "瓦尔",
      "*p",
      "**页",
      "&p"
    ],
    "correctIndex": 3,
    "explanation": "&p 不是 5，因为它是指针 p 的地址（pp 的值）。\nval == *p == **pp。"
  },
  "misconceptions": [
    {
      "wrong": "指针 指针是一种特殊的硬件功能。",
      "correct": "它只是一个保存地址的变量，该变量保存地址。",
      "why": "从内存角度来看，所有指针都是相同大小（32/64 位）的整数变量。"
    }
  ],
  "keyTakeaway": "当您想通过“引用”更改指针变量的值时，请使用双指针。"
