  "quiz": {
    "question": "int x=5; int *p=&x; *p=10; 실행 후 x의 값은?",
    "options": [
      "5",
      "10",
      "15",
      "에러"
    ],
    "correctIndex": 1,
    "explanation": "*p = 10;은 p가 가리키는 x의 메모리에 10을 저장합니다. x가 직접 변경됩니다."
  },
  "misconceptions": [
    {
      "wrong": "*p = 20;은 p의 값을 20으로 바꾼다",
      "correct": "*p = 20;은 p가 '가리키는' 곳(a)의 값을 20으로 바꿉니다.",
      "why": "p = 주소 저장 변수, *p = 그 주소에 있는 값. p = 20과 *p = 20은 완전히 다릅니다!"
    }
  ],
  "keyTakeaway": "*p = 값; 은 원본(a)을 포인터를 통해 간접 수정"
