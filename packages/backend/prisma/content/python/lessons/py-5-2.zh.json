  "quiz": {
    "question": "如果“self”不用作该方法的第一个参数怎么办？",
    "options": [
      "自动添加",
      "发生错误（类型错误）",
      "引用全局变量",
      "成为类方法"
    ],
    "correctIndex": 1,
    "explanation": "调用方法时，Python 会自动将对象本身作为第一个参数传递，但如果您不准备接收它（`self`），则会引发 TypeError，指出“参数数量不正确”。"
  },
  "misconceptions": [
    {
      "wrong": "self는 예약어다",
      "correct": "사실 `self` 이름은 마음대로 바꿔도(`this`, `me`) 동작은 합니다.",
      "why": "하지만 파이썬 커뮤니티의 **강력한 약속(Convention)**이므로 무조건 `self`라고 써야 합니다.\n안 그러면 왕따 당합니다."
    }
  ],
  "keyTakeaway": "메서드 첫 인자는 무조건 `self`. `self.변수`로 나만의 데이터를 저장한다."
}
