  "quiz": {
    "question": "다음 중 에러가 발생하는 코드는?",
    "options": [
      "int(\"123\")",
      "str(123)",
      "\"Number \" + 5",
      "float(\"3.14\")"
    ],
    "correctIndex": 2,
    "explanation": "파이썬은 자동 형변환(Implicit Casting)을 잘 안 해줍니다.\n문자열과 숫자를 더하면 TypeError가 납니다.\n`\"Number \" + str(5)`로 써야 합니다."
  },
  "misconceptions": [
