  "quiz": {
    "question": "如果执行 del x 后 y 也引用同一个对象怎么办？",
    "options": [
      "y 也会抛出 NameError",
      "y 仍然可以访问该对象",
      "物体损坏",
      "y 变为 None"
    ],
    "correctIndex": 1,
    "explanation": "del 仅删除名称 x。\ny仍然指向同一个对象，所以可以正常访问！"
  },
  "misconceptions": [
    {
      "wrong": "del x는 x가 가리키는 객체를 삭제한다",
      "correct": "del x는 x라는 이름(참조)만 삭제한다",
      "why": "객체는 refcount=0일 때만 삭제됩니다.\n다른 이름이 있으면 살아있어요!"
    },
    {
      "wrong": "del 후에도 변수는 None이 된다",
      "correct": "del 후 변수는 완전히 사라진다 (NameError)",
      "why": "x = None은 x가 None을 가리키게 함.\ndel x는 x 자체를 제거!"
    }
  ],
  "keyTakeaway": "del은 이름(참조)만 삭제! 객체는 refcount=0일 때 자동 삭제!"
