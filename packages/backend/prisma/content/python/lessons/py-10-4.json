    "code": "import asyncio\nimport time\n\nasync def fetch_data(id, delay):\n    print(f\"Fetching data {id}...\")\n    await asyncio.sleep(delay)\n    print(f\"Data {id} fetched!\")\n    return {\"id\": id, \"data\": f\"Sample data {id}\"}\n\nasync def main():\n    start = time.time()\n    \n    results = await asyncio.gather(\n        fetch_data(1, 2),\n        fetch_data(2, 1),\n        fetch_data(3, 3)\n    )\n\n    print(f\"\\nResults: {results}\")\n    print(f\"Total time: {time.time() - start:.4f}s\")\n\nasyncio.run(main())",
