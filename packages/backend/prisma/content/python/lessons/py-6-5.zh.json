  "quiz": {
    "question": "obj.method() 和 Class.method(obj) 有什么区别？",
    "options": [
      "结果不同",
      "结果是一样的——前者自动传递 self",
      "只有后者有效",
      "只有电子才能工作"
    ],
    "correctIndex": 1,
    "explanation": "obj.method() 是一个自动传递 self 的绑定方法调用。\nClass.method(obj) 是一个未绑定的调用，显式传递 self。\n结果是一样的！"
  },
  "misconceptions": [
