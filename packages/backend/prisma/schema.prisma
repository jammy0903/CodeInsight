generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  nickname  String   @unique
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  oauthAccounts OAuthAccount[]
  drafts        Draft[]
  submissions   Submission[]
  progress      UserProgress[]

  @@map("users")
}

model OAuthAccount {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String
  providerId String   @map("provider_id")
  email      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Problem {
  id          String       @id @db.Uuid @default(uuid())
  number      Int          @unique
  title       String
  description String       @db.Text
  difficulty  String       @default("bronze_5") @db.VarChar(20)
  tags        Json         @default("[]")
  source      String?
  srcUrl      String?      @map("src_url")
  hints       Json         @default("[]")
  solution    String?      @db.Text
  testCases   Json         @default("[]") @map("test_cases")
  timeLimit   Int          @default(1000) @map("time_limit")
  memoryLimit Int          @default(256) @map("memory_limit")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  drafts      Draft[]
  submissions Submission[]

  @@index([difficulty], map: "idx_problems_difficulty")
  @@map("problems")
}

model Submission {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  problemId     String   @map("problem_id") @db.Uuid
  code          String   @db.Text
  verdict       String   @default("judging")
  executionTime Int?     @map("execution_time")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  problem       Problem  @relation(fields: [problemId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, problemId], map: "idx_submissions_user_problem")
  @@map("submissions")
}

model Draft {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  problemId String   @map("problem_id") @db.Uuid
  code      String   @db.Text
  savedAt   DateTime @default(now()) @map("saved_at") @db.Timestamptz
  problem   Problem  @relation(fields: [problemId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, problemId])
  @@map("drafts")
}

// =============================================
// Course System
// =============================================

model Language {
  id          String    @id
  name        String
  description String?   @db.Text
  icon        String?
  color       String?
  isActive    Boolean   @default(true) @map("is_active")
  order       Int
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  chapters Chapter[]

  @@map("languages")
}

model Chapter {
  id          String   @id
  languageId  String   @map("language_id")
  title       String
  description String?  @db.Text
  keyQuestion String?  @map("key_question") @db.Text
  part        String   @default("syntax")
  partLabel   String?  @map("part_label")
  order       Int
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  language Language @relation(fields: [languageId], references: [id])
  lessons  Lesson[]

  @@index([languageId, order])
  @@index([languageId, part])
  @@map("chapters")
}

model Lesson {
  id            String   @id
  chapterId     String   @map("chapter_id")
  title         String
  description   String?  @db.Text
  difficulty    String   @default("basic")
  order         Int
  estimatedTime Int?     @map("estimated_time")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  chapter  Chapter        @relation(fields: [chapterId], references: [id])
  content  LessonContent?
  quizzes  Quiz[]
  progress UserProgress[]

  @@index([chapterId, order])
  @@map("lessons")
}

model LessonContent {
  id        String   @id
  lessonId  String   @unique @map("lesson_id")
  code      String   @db.Text
  language  String
  steps     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_contents")
}

model Quiz {
  id          String   @id
  lessonId    String   @map("lesson_id")
  type        String
  question    String   @db.Text
  options     Json?
  answer      String
  explanation String?  @db.Text
  order       Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
  @@map("quizzes")
}

model UserProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  lessonId    String    @map("lesson_id")
  status      String    @default("not_started")
  currentStep Int       @default(0) @map("current_step")
  quizScore   Int?      @map("quiz_score")
  quizTotal   Int?      @map("quiz_total")
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  lesson Lesson @relation(fields: [lessonId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_progress")
}
