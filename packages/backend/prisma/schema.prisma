generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db?mode=wal"
}

model User {
  id        String   @id @default(uuid())     // UUID = Primary Key (변경 불가)
  nickname  String   @unique                  // 닉네임 (변경 가능, unique)
  role      String   @default("user")         // 'user' | 'admin'
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  oauthAccounts OAuthAccount[]
  drafts        Draft[]
  submissions   Submission[]
  progress      UserProgress[]

  @@map("users")
}

// OAuth 계정 (1 User : N OAuth Providers)
model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")         // UUID 참조
  provider   String                           // 'google' | 'github' | 'kakao'
  providerId String   @map("provider_id")     // OAuth provider의 고유 ID
  email      String?                          // provider별 이메일 (nullable)
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])            // 같은 provider의 같은 계정 중복 방지
  @@index([userId])
  @@map("oauth_accounts")
}

model Problem {
  id          String       @id
  number      Int          @unique
  title       String
  description String
  difficulty  String       @default("bronze_5")
  tags        String       @default("[]")
  source      String?
  srcUrl      String?      @map("src_url")
  hints       String       @default("[]")
  solution    String?
  testCases   String       @default("[]") @map("test_cases")
  timeLimit   Int          @default(1000) @map("time_limit")
  memoryLimit Int          @default(256) @map("memory_limit")
  createdAt   DateTime     @default(now()) @map("created_at")
  drafts      Draft[]
  submissions Submission[]

  @@index([difficulty], map: "idx_problems_difficulty")
  @@map("problems")
}

model Submission {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  problemId     String   @map("problem_id")
  code          String
  verdict       String   @default("judging")
  executionTime Int?     @map("execution_time")
  createdAt     DateTime @default(now()) @map("created_at")
  problem       Problem  @relation(fields: [problemId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, problemId], map: "idx_submissions_user_problem")
  @@map("submissions")
}

model Draft {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  problemId String   @map("problem_id")
  code      String
  savedAt   DateTime @default(now()) @map("saved_at")
  problem   Problem  @relation(fields: [problemId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, problemId])
  @@map("drafts")
}

// =============================================
// Course System (확장 가능한 학습 코스 구조)
// =============================================

model Language {
  id          String    @id // 'c', 'java', 'python'
  name        String // 'C', 'Java', 'Python'
  description String?
  icon        String? // 아이콘 URL 또는 이모지
  color       String? // 테마 색상 (#hex)
  isActive    Boolean   @default(true) @map("is_active")
  order       Int // 정렬 순서
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  chapters Chapter[]

  @@map("languages")
}

model Chapter {
  id          String   @id
  languageId  String   @map("language_id")
  title       String // '변수와 메모리'
  description String?
  keyQuestion String?  @map("key_question") // '변수는 메모리 어디에?'
  order       Int // 챕터 순서
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  language Language @relation(fields: [languageId], references: [id])
  lessons  Lesson[]

  @@index([languageId, order])
  @@map("chapters")
}

model Lesson {
  id            String   @id
  chapterId     String   @map("chapter_id")
  title         String // '변수 선언하기'
  description   String?
  difficulty    String   @default("basic") // 'basic', 'intermediate', 'advanced'
  order         Int // 레슨 순서
  estimatedTime Int?     @map("estimated_time") // 예상 소요 시간 (분)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  chapter  Chapter        @relation(fields: [chapterId], references: [id])
  content  LessonContent?
  quizzes  Quiz[]
  progress UserProgress[]

  @@index([chapterId, order])
  @@map("lessons")
}

model LessonContent {
  id        String   @id
  lessonId  String   @unique @map("lesson_id")
  code      String // 메인 코드
  language  String // 'c', 'java', 'python'
  steps     String // JSON: [{line, explanation, memoryChanges}]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_contents")
}

model Quiz {
  id          String   @id
  lessonId    String   @map("lesson_id")
  type        String // 'multiple_choice', 'predict_output', 'fill_blank', 'code_fix'
  question    String
  options     String? // JSON: ["선택지1", "선택지2", ...]
  answer      String // 정답
  explanation String? // 해설
  order       Int
  createdAt   DateTime @default(now()) @map("created_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
  @@map("quizzes")
}

model UserProgress {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  lessonId    String    @map("lesson_id")
  status      String    @default("not_started") // 'not_started', 'in_progress', 'completed'
  currentStep Int       @default(0) @map("current_step")
  quizScore   Int?      @map("quiz_score")
  quizTotal   Int?      @map("quiz_total")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_progress")
}
