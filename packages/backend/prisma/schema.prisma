generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Language {
  id           String    @id
  name         String
  description  String?
  icon         String?
  color        String?
  isActive     Boolean   @default(true) @map("is_active")
  isSequential Boolean   @default(true) @map("is_sequential") // 순차 잠금 여부 (false = all open)
  order        Int
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  chapters     Chapter[]

  @@map("languages")
}

model Chapter {
  id          String   @id
  languageId  String   @map("language_id")
  title       String
  description String?
  keyQuestion String?  @map("key_question")
  part        String   @default("syntax")
  partLabel   String?  @map("part_label")
  order       Int
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  language    Language @relation(fields: [languageId], references: [id])
  lessons     Lesson[]

  @@index([languageId, order])
  @@index([languageId, part])
  @@map("chapters")
}

model Lesson {
  id            String         @id
  chapterId     String         @map("chapter_id")
  title         String
  description   String?
  difficulty    String         @default("basic")
  order         Int
  estimatedTime Int?           @map("estimated_time")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  content       LessonContent?
  chapter       Chapter        @relation(fields: [chapterId], references: [id])
  quizzes       Quiz[]

  @@index([chapterId, order])
  @@map("lessons")
}

model LessonContent {
  id        String   @id
  lessonId  String   @unique @map("lesson_id")
  code      String
  language  String
  steps     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_contents")
}

model Quiz {
  id          String   @id
  lessonId    String   @map("lesson_id")
  type        String
  question    String
  options     Json?
  answer      String
  explanation String?
  order       Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, order])
  @@map("quizzes")
}
