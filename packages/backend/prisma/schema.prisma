generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                  @id @default(uuid()) @db.Uuid
  nickname               String                  @unique
  role                   String                  @default("user")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  drafts                 Draft[]
  oauthAccounts          OAuthAccount[]
  submissions            Submission[]
  progress               UserProgress[]
  // 분석 리포트 관련
  activities             LessonActivity[]
  chatHistories          ChatHistory[]
  quizAttempts           QuizAttempt[]
  notes                  UserNote[]
  // 학습 분석 확장
  profile                UserProfile?
  sessionContexts        SessionContext[]
  stepActivities         StepActivity[]
  // 게이미피케이션
  streak                 UserStreak?
  // 독립 퀴즈 (퀴즈 페이지용)
  standaloneQuizAttempts StandaloneQuizAttempt[]
  // 구독 & AI 사용량
  subscription           UserSubscription?
  aiUsageRecords         AIUsageRecord[]
  monthlyUsageSummaries  MonthlyUsageSummary[]

  @@map("users")
}

model OAuthAccount {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String
  providerId String   @map("provider_id")
  email      String? // OAuth 제공자로부터 받은 이메일
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Problem {
  id          String       @id @default(uuid()) @db.Uuid
  number      Int          @unique
  title       String
  description String
  difficulty  String       @default("bronze_5") @db.VarChar(20)
  tags        Json         @default("[]")
  source      String?
  srcUrl      String?      @map("src_url")
  hints       Json         @default("[]")
  solution    String?
  testCases   Json         @default("[]") @map("test_cases")
  timeLimit   Int          @default(1000) @map("time_limit")
  memoryLimit Int          @default(256) @map("memory_limit")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  drafts      Draft[]
  submissions Submission[]

  @@index([difficulty], map: "idx_problems_difficulty")
  @@map("problems")
}

model Submission {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  problemId     String   @map("problem_id") @db.Uuid
  code          String
  verdict       String   @default("judging")
  executionTime Int?     @map("execution_time")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  problem       Problem  @relation(fields: [problemId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@index([userId, problemId], map: "idx_submissions_user_problem")
  @@map("submissions")
}

model Draft {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  problemId String   @map("problem_id") @db.Uuid
  code      String
  savedAt   DateTime @default(now()) @map("saved_at") @db.Timestamptz(6)
  problem   Problem  @relation(fields: [problemId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, problemId])
  @@map("drafts")
}

model Language {
  id           String    @id
  name         String
  description  String?
  icon         String?
  color        String?
  isActive     Boolean   @default(true) @map("is_active")
  isSequential Boolean   @default(true) @map("is_sequential") // 순차 잠금 여부 (false = all open)
  order        Int
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  chapters     Chapter[]

  @@map("languages")
}

model Chapter {
  id          String   @id
  languageId  String   @map("language_id")
  title       String
  description String?
  keyQuestion String?  @map("key_question")
  part        String   @default("syntax")
  partLabel   String?  @map("part_label")
  order       Int
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  language    Language @relation(fields: [languageId], references: [id])
  lessons     Lesson[]

  @@index([languageId, order])
  @@index([languageId, part])
  @@map("chapters")
}

model Lesson {
  id             String           @id
  chapterId      String           @map("chapter_id")
  title          String
  description    String?
  difficulty     String           @default("basic")
  order          Int
  estimatedTime  Int?             @map("estimated_time")
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  content        LessonContent?
  chapter        Chapter          @relation(fields: [chapterId], references: [id])
  quizzes        Quiz[]
  progress       UserProgress[]
  // 분석 리포트 관련
  activities     LessonActivity[]
  chatHistories  ChatHistory[]
  notes          UserNote[]
  stepActivities StepActivity[]

  @@index([chapterId, order])
  @@map("lessons")
}

model LessonContent {
  id        String   @id
  lessonId  String   @unique @map("lesson_id")
  code      String
  language  String
  steps     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_contents")
}

model Quiz {
  id          String        @id
  lessonId    String        @map("lesson_id")
  type        String
  question    String
  options     Json?
  answer      String
  explanation String?
  order       Int
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // 분석 리포트 관련
  attempts    QuizAttempt[]
  notes       UserNote[]

  @@index([lessonId, order])
  @@map("quizzes")
}

model UserProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  lessonId    String    @map("lesson_id")
  status      String    @default("not_started")
  currentStep Int       @default(0) @map("current_step")
  quizScore   Int?      @map("quiz_score")
  quizTotal   Int?      @map("quiz_total")
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("user_progress")
}

// ============================================
// 분석 리포트 관련 모델 (2026-01-12 추가)
// ============================================

// 레슨 체류 시간 기록
model LessonActivity {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  lessonId  String    @map("lesson_id")
  startedAt DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  duration  Int? // 초 단위 (계산된 값, 빠른 집계용)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson           @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  // 학습 분석 확장
  sessionContexts SessionContext[]
  stepActivities  StepActivity[]

  @@index([userId, startedAt]) // 사용자별 시간순 조회
  @@index([lessonId]) // 레슨별 통계
  @@index([startedAt]) // 날짜 범위 쿼리
  @@map("lesson_activities")
}

// AI 질문 히스토리
model ChatHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  lessonId  String?  @map("lesson_id") // nullable: 레슨 밖에서도 질문 가능
  context   String?  @db.VarChar(50) // "lesson", "playground", "general"
  question  String   @db.Text
  answer    String   @db.Text
  tokens    Int? // AI 토큰 사용량 (비용 추적용)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt]) // 사용자별 히스토리
  @@index([lessonId]) // 레슨별 질문 통계
  @@index([createdAt]) // 시간 범위 쿼리 + 오래된 데이터 삭제
  @@map("chat_histories")
}

// 퀴즈 시도 기록 (오답 분석용)
model QuizAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  quizId     String   @map("quiz_id")
  userAnswer String   @map("user_answer") @db.VarChar(500)
  isCorrect  Boolean  @map("is_correct")
  timeSpent  Int?     @map("time_spent") // 문제 풀이 시간 (초)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt]) // 사용자별 시간순
  @@index([userId, isCorrect]) // 오답만 빠르게 조회
  @@index([quizId]) // 퀴즈별 정답률 통계
  @@map("quiz_attempts")
}

// 사용자 개념 노트
model UserNote {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  quizId      String?  @map("quiz_id") // 퀴즈에서 추가 시
  lessonId    String   @map("lesson_id") // 어떤 레슨의 개념
  source      String   @db.VarChar(20) // "quiz" | "lesson" | "manual"
  concept     String   @db.VarChar(100) // 개념 키워드 (예: "포인터", "malloc")
  content     String   @db.Text // 노트 본문
  isFromWrong Boolean  @default(false) @map("is_from_wrong") // 오답 후 추가 여부
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz   Quiz?  @relation(fields: [quizId], references: [id], onDelete: SetNull)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@index([userId, concept]) // 개념별 노트 조회
  @@index([userId, lessonId]) // 레슨별 노트 조회
  @@index([userId, isFromWrong]) // 오답 노트만 조회
  @@index([concept]) // 전체 사용자 취약 개념 통계
  @@map("user_notes")
}

// ============================================
// 학습 분석 리포트 확장 모델 (2026-01-18 추가)
// ============================================

// 사용자 프로필 (온보딩 설문)
model UserProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  // 온보딩 설문 결과
  ageGroup            String?  @map("age_group") @db.VarChar(20) // "10s", "20s", "30s", "40s+"
  occupation          String?  @db.VarChar(30) // "student_middle", "student_high", "student_univ", "job_seeker", "worker", "other"
  programmingExp      String?  @map("programming_exp") @db.VarChar(20) // "none", "less_1y", "1_3y", "3y_plus"
  learningGoal        String?  @map("learning_goal") @db.VarChar(30) // "basics", "job_prep", "skill_up", "curiosity"
  // 메타
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// 세션 컨텍스트 (자동 수집)
model SessionContext {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  lessonActivityId String?  @map("lesson_activity_id") @db.Uuid // LessonActivity와 연결 (nullable: 레슨 외 활동)
  // 디바이스 정보
  screenWidth      Int?     @map("screen_width")
  screenHeight     Int?     @map("screen_height")
  orientation      String?  @db.VarChar(20) // "portrait", "landscape"
  inputMethod      String?  @map("input_method") @db.VarChar(10) // "touch", "mouse"
  userAgent        String?  @map("user_agent") @db.VarChar(500)
  language         String?  @db.VarChar(10) // "ko", "en", etc.
  // 네트워크 정보
  connectionType   String?  @map("connection_type") @db.VarChar(20) // "4g", "wifi", etc.
  effectiveType    String?  @map("effective_type") @db.VarChar(10) // "slow-2g", "2g", "3g", "4g"
  // 시간 컨텍스트
  localHour        Int?     @map("local_hour") // 0-23
  localWeekday     Int?     @map("local_weekday") // 0-6 (일-토)
  timezone         String?  @db.VarChar(50) // "Asia/Seoul"
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonActivity LessonActivity? @relation(fields: [lessonActivityId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([localHour]) // 시간대별 학습 패턴
  @@index([localWeekday]) // 요일별 학습 패턴
  @@map("session_contexts")
}

// 스텝별 상세 행동 (Phase 0-2)
model StepActivity {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  lessonActivityId String   @map("lesson_activity_id") @db.Uuid
  lessonId         String   @map("lesson_id")
  stepIndex        Int      @map("step_index") // 0-based 스텝 인덱스
  // Phase 0 (필수)
  duration         Int? // 체류 시간 (초)
  wentBack         Boolean  @default(false) @map("went_back") // 이 스텝에서 뒤로 갔는지
  // Phase 1 (권장) - 시각화
  visHoverCount    Int?     @map("vis_hover_count") // 메모리 블록 호버 횟수
  visClickCount    Int?     @map("vis_click_count") // 메모리 블록 클릭 횟수
  // Phase 1 (권장) - AI
  aiQuestionCount  Int?     @map("ai_question_count") // 이 스텝에서 AI 질문 횟수
  // Phase 2 (심화)
  codeSelections   Int?     @map("code_selections") // 코드 선택 횟수
  scrollEvents     Int?     @map("scroll_events") // 스크롤 이벤트 횟수
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonActivity LessonActivity @relation(fields: [lessonActivityId], references: [id], onDelete: Cascade)
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([lessonActivityId, stepIndex]) // 한 활동 내 스텝은 유니크
  @@index([userId, lessonId])
  @@index([lessonId, stepIndex]) // 스텝별 평균 시간 등 통계
  @@map("step_activities")
}

// ============================================
// 게이미피케이션 모델 (2026-01-18 추가)
// ============================================

// 연속 학습 스트릭
model UserStreak {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  currentStreak Int       @default(0) @map("current_streak") // 현재 연속 일수
  longestStreak Int       @default(0) @map("longest_streak") // 최장 연속 기록
  lastActiveAt  DateTime? @map("last_active_at") @db.Date // 마지막 활동일 (날짜만)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

// ============================================
// 독립 퀴즈 시스템 (2026-01-27 추가)
// WHY: 레슨과 분리된 퀴즈 페이지용 (학습 분석, 취약 개념 추적)
// ============================================

// 독립 퀴즈 문제 정의
model StandaloneQuiz {
  id String @id // "ox-c-ptr-q1" 형식

  // 📂 분류 정보
  language     String @db.VarChar(20) // "c", "javascript", "java", "python"
  quizType     String @map("quiz_type") @db.VarChar(30) // "ox", "multiple-choice", "fill-blank"
  chapterId    String @map("chapter_id") @db.VarChar(50) // "c-var", "c-ptr"
  chapterTitle String @map("chapter_title") @db.VarChar(100) // "변수와 자료형"

  // 📝 문제 내용
  question    String @db.Text // 문제 원문
  options     Json? // 객관식 선택지 (["A", "B", "C", "D"])
  answer      String @db.VarChar(500) // 정답 ("true", "A", "malloc")
  explanation String @db.Text // 해설

  // 🎯 분석용 메타데이터
  concepts   String[] @default([]) // 개념 태그 ["포인터", "메모리주소"]
  difficulty String   @default("medium") @db.VarChar(20) // "easy", "medium", "hard"
  orderNum   Int      @map("order_num") // 챕터 내 순서

  // 메타
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 관계
  attempts StandaloneQuizAttempt[]

  @@index([language, quizType]) // 언어+유형별 조회
  @@index([language, chapterId]) // 언어+챕터별 조회
  @@index([language, quizType, chapterId]) // 복합 조회
  @@map("standalone_quizzes")
}

// 독립 퀴즈 시도 기록
model StandaloneQuizAttempt {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  quizId String @map("quiz_id")

  // 📊 시도 데이터
  userAnswer String  @map("user_answer") @db.VarChar(500)
  isCorrect  Boolean @map("is_correct")
  timeSpent  Int?    @map("time_spent") // 풀이 시간 (초)

  // 🔄 재시도 추적
  attemptNumber Int @default(1) @map("attempt_number")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // 관계
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz StandaloneQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // 사용자별 시간순
  @@index([userId, isCorrect]) // 오답만 빠르게 조회
  @@index([quizId]) // 퀴즈별 정답률 통계
  @@index([userId, quizId]) // 재시도 횟수 계산용
  @@map("standalone_quiz_attempts")
}

// ============================================
// 구독 & AI 사용량 추적 (2026-02-01 추가)
// ============================================

// 구독 플랜 정의
model SubscriptionPlan {
  id                String             @id // "free", "pro", "premium"
  name              String             @db.VarChar(50) // "무료", "Pro", "Premium"
  description       String?            @db.Text
  price             Int                @default(0) // 원화 (0 = 무료)
  currency          String             @default("KRW") @db.VarChar(3)
  billingPeriod     String             @default("monthly") @map("billing_period") @db.VarChar(20) // "monthly", "yearly"
  // AI 사용 제한
  monthlyTokenLimit Int?               @map("monthly_token_limit") // null = 무제한
  dailyTokenLimit   Int?               @map("daily_token_limit") // null = 무제한
  // 기능 접근 권한
  features          String[]           @default([]) // ["ai_chat", "ai_explain", "priority_support"]
  // 메타
  isActive          Boolean            @default(true) @map("is_active")
  order             Int                @default(0) // 표시 순서
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  // 관계
  subscriptions     UserSubscription[]

  @@map("subscription_plans")
}

// 사용자 구독 상태
model UserSubscription {
  id                     String           @id @default(uuid()) @db.Uuid
  userId                 String           @unique @map("user_id") @db.Uuid
  planId                 String           @map("plan_id")
  // 구독 상태
  status                 String           @default("active") @db.VarChar(20) // "active", "canceled", "past_due", "trialing"
  // 결제 기간
  currentPeriodStart     DateTime         @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime         @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean          @default(false) @map("cancel_at_period_end") // 기간 종료 시 해지 예약
  // 결제 정보
  paymentProvider        String?          @map("payment_provider") @db.VarChar(20) // "google_play", "toss", "kakaopay"
  externalSubscriptionId String?          @map("external_subscription_id") @db.VarChar(255) // 외부 결제 시스템 ID
  externalCustomerId     String?          @map("external_customer_id") @db.VarChar(255) // 외부 고객 ID
  // 메타
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  // 관계
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([currentPeriodEnd]) // 만료 예정 구독 조회
  @@index([paymentProvider, externalSubscriptionId]) // 웹훅에서 빠른 조회
  @@map("user_subscriptions")
}

// AI 사용량 기록 (요청별 상세)
model AIUsageRecord {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  // 요청 정보
  endpoint         String   @db.VarChar(50) // "chat", "explain-step", "analyze-report"
  model            String   @db.VarChar(50) // "deepseek-chat", "ollama-llama3"
  // 토큰 사용량
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  totalTokens      Int      @map("total_tokens")
  // 비용 (USD)
  cost             Decimal  @db.Decimal(10, 6) // $0.000175 같은 작은 값도 저장
  // 요청 컨텍스트
  lessonId         String?  @map("lesson_id")
  context          String?  @db.VarChar(50) // "lesson", "playground", "general"
  // 메타
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // 관계
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt]) // 사용자별 시간순
  @@index([createdAt]) // 전체 시간순, 월별 집계
  @@index([userId, endpoint]) // 사용자별 엔드포인트 통계
  @@map("ai_usage_records")
}

// 월별 사용량 집계 (빠른 조회용)
model MonthlyUsageSummary {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  yearMonth    String   @map("year_month") @db.VarChar(7) // "2024-01"
  // 집계 데이터
  totalTokens  Int      @default(0) @map("total_tokens")
  totalCost    Decimal  @default(0) @map("total_cost") @db.Decimal(10, 4) // USD
  requestCount Int      @default(0) @map("request_count")
  // 엔드포인트별 breakdown
  chatTokens   Int      @default(0) @map("chat_tokens")
  explainTokens Int     @default(0) @map("explain_tokens")
  otherTokens  Int      @default(0) @map("other_tokens")
  // 메타
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  // 관계
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth])
  @@index([yearMonth]) // 월별 전체 통계
  @@map("monthly_usage_summaries")
}
