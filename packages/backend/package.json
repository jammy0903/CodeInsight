{
  "name": "@codeinsight/backend",
  "version": "1.0.0",
  "description": "CodeInsight Backend API",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "(cd src/modules/simulators/java/agent && mkdir -p build/classes && javac -encoding UTF-8 -d build/classes src/main/java/com/vis/*.java && jar cfe build/debugger-agent.jar com.vis.DebuggerAgent -C build/classes .) && tsc",
    "start": "node dist/app.js",
    "seed": "ts-node prisma/seed.ts",
    "seed:quizzes": "ts-node prisma/seed-quizzes.ts",
    "backup": "ts-node scripts/backup.ts",
    "restore": "ts-node scripts/backup.ts restore",
    "import-tc": "ts-node scripts/import-testcases.ts",
    "import-tc:watch": "ts-node scripts/import-testcases.ts watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.24.8",
    "@babel/traverse": "^7.24.8",
    "@babel/types": "^7.28.6",
    "@codeinsight/shared": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@libsql/client": "^0.15.15",
    "@notionhq/client": "^5.6.0",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/adapter-libsql": "^7.2.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@prisma/client-runtime-utils": "^7.2.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase-admin": "^13.6.0",
    "pg": "^8.16.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.0.16",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
