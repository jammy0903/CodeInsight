# ========================================
# CodeInsight Caddyfile
# ========================================
# ⚠️  이 파일은 프로덕션 배포(service)용입니다.
#
# 개발(development) 환경에서는:
#   ./start-dev 스크립트를 사용하세요!
#
# Caddy는 자동으로:
#   - Let's Encrypt HTTPS 인증서 발급/갱신
#   - HTTP → HTTPS 리다이렉트
#   - HTTP/2 활성화
# ========================================

# 프로덕션 도메인 (실제 배포 시 변경)
# 로컬 테스트: localhost
localhost {
    # Frontend: 정적 파일 서빙
    root * /var/www/frontend
    file_server

    # API 요청 → Backend로 프록시
    reverse_proxy /api/* backend:3002

    # SPA 라우팅 (404 → index.html)
    try_files {path} /index.html

    # 압축 활성화
    encode gzip zstd

    # 보안 헤더
    header {
        # XSS 방어
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"

        # CSP (Content Security Policy)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' http://localhost:3002 https://firebase.googleapis.com https://identitytoolkit.googleapis.com"

        # HSTS (HTTPS 강제)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # 로그 활성화 (프로덕션)
    log {
        output file /var/log/caddy/access.log
        format json
    }
}

# 프로덕션 도메인 예시 (실제 배포 시 주석 해제)
