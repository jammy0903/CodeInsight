{
  "name": "codeinsight-monorepo",
  "version": "1.0.0",
  "description": "CodeInsight - Code Execution Learning Platform",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"@codeinsight/*\" dev",
    "build": "pnpm --recursive --filter \"@codeinsight/*\" build",
    "test": "pnpm --recursive --filter \"@codeinsight/*\" test",
    "clean": "pnpm --recursive --filter \"@codeinsight/*\" clean"
  },
  "keywords": [
    "education",
    "c",
    "memory",
    "visualization"
  ],
  "author": "jammy0903",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ],
    "ignoredBuiltDependencies": [
      "core-js"
    ]
  },
  "devDependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/cli": "6.2.1",
    "@capacitor/core": "6.2.1",
    "@capacitor/ios": "6.2.1",
    "@playwright/test": "^1.57.0",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "shadcn": "^3.7.0",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-firebase/authentication": "6.3.1",
    "swiper": "^12.1.0"
  }
}
