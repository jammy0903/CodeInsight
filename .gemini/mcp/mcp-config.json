{
  "commands": [
    {
      "name": "monorepo: dev",
      "command": "pnpm --parallel --filter \"@codeinsight/*\" dev",
      "description": "Run all workspace packages in dev mode."
    },
    {
      "name": "monorepo: build",
      "command": "pnpm --recursive --filter \"@codeinsight/*\" build",
      "description": "Build all workspace packages."
    },
    {
      "name": "monorepo: test",
      "command": "pnpm --recursive --filter \"@codeinsight/*\" test",
      "description": "Run tests for all workspace packages."
    },
    {
      "name": "frontend: dev",
      "command": "pnpm --filter @codeinsight/frontend dev",
      "description": "Start frontend dev server."
    },
    {
      "name": "frontend: build",
      "command": "pnpm --filter @codeinsight/frontend build",
      "description": "Build frontend for production."
    },
    {
      "name": "frontend:storybook",
      "command": "pnpm --filter @codeinsight/frontend storybook",
      "description": "Run the Storybook UI development environment."
    },
    {
      "name": "backend: dev",
      "command": "pnpm --filter @codeinsight/backend dev",
      "description": "Start backend dev server."
    },
    {
      "name": "backend: build",
      "command": "pnpm --filter @codeinsight/backend build",
      "description": "Build backend for production."
    }
  ]
}